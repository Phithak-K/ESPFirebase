# ตัวอย่างไฟล์ secrets.yaml สำหรับใส่ค่าเฉพาะของตนเอง
# คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น secrets.yaml (ไฟล์นี้จะถูก .gitignore ซ่อนไว้ ไม่หลุดขึ้น GitHub)

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# ใส่ Database URL ของ Firebase RTDB ตัวอย่าง:
# https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
firebase_latest_url: "https://YOUR-DATABASE-URL/lab/esp32-01/latest.json"
firebase_history_url: "https://YOUR-DATABASE-URL/lab/esp32-01/history.json"
firebase_latest_url_hw: "https://YOUR-DATABASE-URL/iot-999/latest.json"
firebase_history_url_hw: "https://YOUR-DATABASE-URL/iot-999/history.json"
